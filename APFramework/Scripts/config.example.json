{
  "debug": false,
  "capability_file": "APCapabilities.json",
  "seed_file": null,
  "save_state_file": "APSaveState.json",
  "framework_dir": "APFramework",
  "discovery": {
    "auto_discover": true,
    "registry_file": "ap_registry.json",
    "adapter_dir": "adapters",
    "ue4ss_mods_dir": "../"
  },
  "ap_client": {
